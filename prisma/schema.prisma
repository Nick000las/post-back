generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO (agência/CRM): agência = users; cada users pode ter vários clients; accounts/posts passam
// a pertencer a um client, não mais diretamente a um user.
model clients {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  user_id    Int
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_client_user")
  accounts   accounts[]
  posts      posts[]
}

model accounts {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  platform            String          @db.VarChar(50)
  platform_account_id String?         @unique @db.VarChar(100)
  access_token        String
  client_id           Int
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  post_accounts       post_accounts[]
  clients             clients         @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_client")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model post_accounts {
  post_id         Int
  account_id      Int
  delivery_status String    @default("PENDING") @db.VarChar(20)
  api_post_id     String?   @db.VarChar(100)
  error_message   String?
  job_id          String?   @db.VarChar(255)
  processed_at    DateTime? @db.Timestamptz(6)
  accounts        accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batch_account")
  posts           posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batch_post")

  @@id([post_id, account_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posts {
  id            Int             @id @default(autoincrement())
  caption       String?
  file_path     String          @db.VarChar(255)
  file_name     String?         @db.VarChar(255)
  file_type     String?         @db.VarChar(100)
  status        String          @default("DRAFT") @db.VarChar(20)
  // TODO (agendamento): horário alvo da publicação, em UTC. Preencher só quando status = 'SCHEDULED'.
  scheduled_for DateTime?       @db.Timestamptz(6)
  client_id     Int
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  post_accounts post_accounts[]
  clients       clients         @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_post_client")
}

model users {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  clients       clients[]
}
