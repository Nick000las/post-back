generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO (agência/CRM): agência = users; cada users pode ter vários clients; accounts/posts passam
// a pertencer a um client, não mais diretamente a um user.
model clients {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  // Caminho (relativo a .uploads/) do avatar/logo do client, exibido no card do Feed Global —
  // mesmo padrão de posts.thumbnail_path. Nullable: nenhum endpoint de upload existe ainda.
  avatar_path String?    @db.VarChar(255)
  user_id     Int
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_client_user")
  accounts    accounts[]
  posts       posts[]
  columns     columns[]
}

model accounts {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  platform            String          @db.VarChar(50)
  platform_account_id String?         @unique @db.VarChar(100)
  access_token        String
  client_id           Int
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  post_accounts       post_accounts[]
  clients             clients         @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_client")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model post_accounts {
  post_id         Int
  account_id      Int
  delivery_status String    @default("PENDING") @db.VarChar(20)
  api_post_id     String?   @db.VarChar(100)
  error_message   String?
  job_id          String?   @db.VarChar(255)
  processed_at    DateTime? @db.Timestamptz(6)
  accounts        accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batch_account")
  posts           posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batch_post")

  @@id([post_id, account_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posts {
  id             Int             @id @default(autoincrement())
  caption        String?
  // Nullable: um draft pode ficar temporariamente sem mídia (removida no editor do Kanban, ou — no
  // futuro — criado por IA antes de qualquer arquivo existir). publicarDraft/agendarDraft bloqueiam a
  // publicação enquanto file_path for null.
  file_path      String?         @db.VarChar(255)
  file_name      String?         @db.VarChar(255)
  file_type      String?         @db.VarChar(100)
  // Caminho (relativo a .uploads/thumbs/) da miniatura gerada no upload. Nullable: posts anteriores a
  // essa feature não têm, e a geração pode falhar sem que isso derrube o upload principal — o
  // frontend deve cair para file_path quando thumbnail_path for null.
  thumbnail_path String?         @db.VarChar(255)
  status         String          @default("DRAFT") @db.VarChar(20)
  // TODO (agendamento): horário alvo da publicação, em UTC. Preencher só quando status = 'SCHEDULED'.
  scheduled_for  DateTime?       @db.Timestamptz(6)
  // Setado uma única vez em postService#finalizarStatusSeCompleto, quando o post fecha como
  // PUBLISHED/PARTIAL/FAILED. Ao contrário de updated_at (que qualquer edição futura altera), é a
  // fonte confiável de "quando foi publicado de fato" — usado pelo filtro de mês/ano do Feed do
  // Cliente. Nullable: posts anteriores a essa feature (e drafts/scheduled) não têm.
  published_at   DateTime?       @db.Timestamptz(6)
  // Preenchido só pela importação do Lab de IA — NUNCA lido pelo motor de publicação (só
  // scheduled_for aciona a fila/kanban "Agendado"). Puramente informativo: o frontend usa isso pra
  // pré-selecionar a data no datepicker do modal de "Agendar", sem travar o post como agendado de
  // verdade até o usuário confirmar.
  suggested_date DateTime?       @db.Timestamptz(6)
  // Formato extraído do PDF pela IA: 'FEED' (imagem única ou carrossel — a distinção é decidida
  // depois pela quantidade de arquivos anexados, não pela IA), 'STORY' ou 'REELS'. Sem enum
  // reforçado no schema ainda — mesmo padrão informal de status/platform hoje (string livre
  // validada em código, ver FORMATOS_VALIDOS em src/constants/aiLab.js).
  format         String?         @db.VarChar(20)
  client_id      Int
  // Kanban: coluna atual do post no quadro do client. Nullable só por segurança de migração — toda
  // criação/movimentação de post no código é responsável por manter isso preenchido (ver
  // postService#resolverColumnId). Sem coluna definida == deveria cair na coluna "Ideias" do client.
  column_id      Int?
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  post_accounts  post_accounts[]
  card_comments  card_comments[]
  clients        clients         @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_post_client")
  columns        columns?        @relation(fields: [column_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_post_column")

  @@index([client_id, column_id])
}

// Chat de colaboração por card do Kanban. Um comentário pertence a um post (o "card") e a um users
// (autor). Anexo é opcional e único por comentário (padrão WhatsApp/Slack: 1 anexo por mensagem) — os
// campos de arquivo vivem como colunas próprias (mesmo padrão de posts.file_path/file_name/file_type),
// não numa tabela filha, já que não há caso de uso de múltiplos anexos por mensagem.
model card_comments {
  id                       Int       @id @default(autoincrement())
  post_id                  Int
  user_id                  Int
  text                     String?
  // Nome gerado em disco (padrão Date.now() + extname, igual aos outros uploads do projeto), relativo
  // a .uploads/comment-attachments/. Nullable: nem todo comentário tem anexo.
  attachment_path          String?   @db.VarChar(255)
  // Nome original do arquivo enviado — só para exibição (nome truncado no "card de arquivo" do chat).
  attachment_original_name String?   @db.VarChar(255)
  attachment_mime_type     String?   @db.VarChar(100)
  attachment_size          Int?
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  posts                    posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_post")
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_user")

  @@index([post_id, created_at])
}

// Colunas do quadro Kanban de um client. As 3 colunas fixas (Ideias/Agendado/Finalizado) são criadas
// automaticamente na criação do client (ver prismaAdapter.criarClient) e nunca podem ser renomeadas,
// reordenadas ou excluídas pela UI — só colunas dinâmicas (is_fixed = false) podem.
model columns {
  id         Int       @id @default(autoincrement())
  client_id  Int
  name       String    @db.VarChar(100)
  order      Int
  is_fixed   Boolean   @default(false)
  // Discriminador estável das colunas fixas: 'IDEIAS' | 'AGENDADO' | 'FINALIZADO' | null (dinâmica).
  // Nunca renomear estas strings depois de implementado — o gancho de IA (resolução da coluna default
  // de um post novo) e o futuro salto automático de status dependem delas.
  fixed_key  String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  clients    clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_column_client")
  posts      posts[]

  @@unique([client_id, fixed_key], map: "uq_column_client_fixed_key")
  @@index([client_id, order])
}

model users {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  email         String          @unique @db.VarChar(150)
  password_hash String          @db.VarChar(255)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  clients       clients[]
  card_comments card_comments[]
}
